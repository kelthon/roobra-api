<!-- Action button partial with Outlook VML and mobile overrides -->
<table border="0" cellpadding="0" cellspacing="0" width="100%">
  <tr>
    <td align="center" style="padding: 12px 0 24px 0;">
      <!-- Outlook Desktop fallback (VML) -->
      <!--[if mso]>
      <v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" xmlns:w="urn:schemas-microsoft-com:office:word" href="{{url}}" style="height:48px;v-text-anchor:middle;width:240px;" arcsize="10%" strokecolor="{{#if isSecondary}}#3d4255{{else}}#e6194b{{/if}}" fillcolor="{{#if isSecondary}}#232733{{else}}#e6194b{{/if}}">
        <w:anchorlock/>
        <center style="color:{{#if isSecondary}}#f5f6f8{{else}}#ffffff{{/if}};font-family:sans-serif;font-size:15px;font-weight:bold;">{{text}}</center>
      </v:roundrect>
      <![endif]-->
      <!-- Standard HTML button for modern clients and mobile -->
      <a href="{{url}}" target="_blank" class="{{#if isSecondary}}btn-secondary{{else}}btn-action{{/if}} btn-responsive" style="mso-hide: all;">
        {{text}}
      </a>
    </td>
  </tr>
</table>
