<table border="0" cellpadding="0" cellspacing="0" width="100%">
  <!-- Category badge -->
  <tr>
    <td align="left" style="padding-bottom: 14px;">
      <span class="badge-category">{{#if categoryBadge}}{{categoryBadge}}{{else}}Account Setup{{/if}}</span>
    </td>
  </tr>

  <!-- Email title -->
  <tr>
    <td class="text-title">{{#if title}}{{title}}{{else}}Create your password{{/if}}</td>
  </tr>

  <!-- Message body -->
  <tr>
    <td class="text-body">
      Hi, <strong style="color: #ffffff;">{{username}}</strong>.<br /><br />
      {{#if messageBody}}
        {{messageBody}}
      {{else}}
        Your account is almost ready. Click the button below to set your initial password and start reading.
      {{/if}}
    </td>
  </tr>

  <!-- Call to action button partial -->
  <tr>
    <td>
      {{> action-button url=createPasswordUrl text=(#if buttonText buttonText "Set Password") isSecondary=false}}
    </td>
  </tr>

  <!-- Security note -->
  <tr>
    <td class="text-muted" style="padding-top: 24px; border-top: 1px solid #232733;">
      This security link expires in <strong>{{#if expiresIn}}{{expiresIn}}{{else}}24{{/if}} hours</strong>. If you did not sign up, please ignore this email.
    </td>
  </tr>
</table>
