<table border="0" cellpadding="0" cellspacing="0" width="100%">
  <!-- Category badge -->
  <tr>
    <td align="left" style="padding-bottom: 14px;">
      <span class="badge-category">{{categoryBadge}}</span>
    </td>
  </tr>

  <!-- Email title -->
  <tr>
    <td class="text-title">{{title}}</td>
  </tr>

  <!-- Message body -->
  <tr>
    <td class="text-body">
      Hi, <strong style="color: #ffffff;">{{username}}</strong>.<br /><br />
      {{messageBody}}
    </td>
  </tr>

  <!-- Call to action button partial -->
  <tr>
    <td>
      {{> action-button url=resetPasswordUrl text=buttonText isSecondary=false}}
    </td>
  </tr>

  <!-- Security expiration notice -->
  <tr>
    <td class="text-muted" style="padding-top: 24px; border-top: 1px solid #232733;">
      This security link expires in <strong>{{expiresIn}} minutes</strong>. If you did not initiate this request, no further action is required.
    </td>
  </tr>
</table>
