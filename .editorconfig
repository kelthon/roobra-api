[root]
# Project-wide EditorConfig
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.json]
trim_trailing_whitespace = false

[*.md]
trim_trailing_whitespace = false

[*.prisma]
trim_trailing_whitespace = false

[src/generated/**]
# Generated files (Prisma client) - avoid trimming or forcing final newline
trim_trailing_whitespace = false
insert_final_newline = false
