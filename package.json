{
  "name": "roobra-api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "deploy": "nest deploy",
    "format": "prettier --write \"{src,test,prisma,scripts}/**/*.ts\" \"*.ts\"",
    "lint": "oxlint --type-aware src/ test/",
    "typecheck": "tsc --noEmit",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "preview:email": "tsx scripts/preview-email.ts"
  },
  "dependencies": {
    "@nestjs-modules/mailer": "3.0.2",
    "@nestjs/common": "12.1.0",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "12.1.0",
    "@nestjs/jwt": "12.0.2",
    "@nestjs/mapped-types": "12.0.0",
    "@nestjs/passport": "12.0.0",
    "@nestjs/platform-express": "12.1.0",
    "@nestjs/throttler": "6.7.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "18.0.3",
    "handlebars": "4.7.9",
    "luxon": "^3.7.2",
    "nanoid": "6.0.1",
    "nodemailer": "10.0.8",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "8.23.0",
    "phone": "^3.1.71",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/mau": "0.2.8",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "12.1.0",
    "@types/express": "^5.0.0",
    "@types/luxon": "^3.7.5",
    "@types/node": "^24.13.6",
    "@types/nodemailer": "8.0.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/pg": "8.23.1",
    "@types/preview-email": "3.1.0",
    "@types/supertest": "^6.0.2",
    "@vitest/coverage-v8": "5.0.2",
    "oxlint": "1.85.0",
    "oxlint-tsgolint": "7.0.2003",
    "prettier": "3.9.9",
    "preview-email": "3.4.0",
    "prisma": "7.10.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "tsx": "4.23.15",
    "typescript": "^6.0.3",
    "vitest": "5.0.2"
  }
