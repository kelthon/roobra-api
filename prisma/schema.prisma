// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  SUBSCRIBER      @map("subscriber")
  ADMIN           @map("admin")
  CONTENT_MANAGER @map("content_manager")
  SUPPORT_AGENT   @map("support_agent")
  STAFF           @map("staff")

  @@map("user_roles")
}

model User {
  id String @id @default(nanoid()) @db.Char(21)

  username        String    @unique @db.VarChar(75)
  email           String    @unique @db.VarChar(255)
  photoUrl        String?   @map("photo_url") @db.VarChar(255)
  googleId        String?   @unique @map("google_id") @db.VarChar(255)
  hashedPassword  String?   @map("hashed_password") @db.VarChar(128)
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz
  birthdate       DateTime? @db.Date
  role            UserRole  @default(SUBSCRIBER)

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  logs                AuditLog[]
  subscriber          Subscriber?
  staffMember         StaffMember?

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  @@map("users")
}

model Subscriber {
  id BigInt @id @default(autoincrement())

  accessExpirationDate DateTime @map("access_expiration_date") @db.Date
  renovationDate       DateTime @map("renovation_date") @db.Date

  subscriptionId  BigInt           @map("subscription_id")
  subscription    Subscription     @relation(fields: [subscriptionId], references: [id])
  userId          String           @unique @map("user_id")
  user            User             @relation(fields: [userId], references: [id])
  viewHistory     UserHistory[]
  promotionUsages PromotionUsage[]
  orders          Order[]
  userReadLists   UserReadList[]

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  @@map("subscribers")
}

model StaffMember {
  id Int @id @default(autoincrement())

  isActive Boolean @default(true) @map("is_active")

  userId String @unique @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  @@map("staff_members")
}

model RefreshToken {
  id              BigInt   @id @default(autoincrement())
  hashedToken     String   @unique @map("hashed_token") @db.VarChar(255)
  isRevoked       Boolean  @default(false) @map("is_revoked")
  userAgent       String?  @default("unspecified") @map("user_agent") @db.VarChar(35)
  operatingSystem String?  @default("unspecified") @map("operating_system") @db.VarChar(35)
  expiresAt       DateTime @map("expires_at") @db.Timestamptz

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("refresh_tokens")
}

model PasswordResetToken {
  id          BigInt    @id @default(autoincrement())
  hashedToken String    @unique @map("hashed_token") @db.VarChar(255)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz
  usedAt      DateTime? @map("used_at") @db.Timestamptz

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("password_reset_tokens")
}

model Media {
  id BigInt @id @default(autoincrement())

  name                      String   @db.VarChar(100)
  slug                      String   @unique @default(nanoid()) @db.VarChar(21)
  description               String?  @db.Text
  coverImageUrl             String?  @map("cover_image_url") @db.VarChar(255)
  alternativeCoverImageUrls String[] @map("alternative_cover_image_urls")
  pageSampleImageUrls       String[] @map("page_sample_image_urls")
  authors                   String[]
  isPrivate                 Boolean  @default(false) @map("is_private")
  isFree                    Boolean  @default(false) @map("is_free")

  volumes       MediaVolume[]
  genres        MediaGenre[]   @relation("media_to_media_genres")
  userReadLists UserReadList[]

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  @@map("medias")
}

model MediaVolume {
  id BigInt @id @default(autoincrement())

  number        Int?     @db.SmallInt
  title         String   @db.VarChar(100)
  description   String?  @db.Text
  coverImageUrl String?  @map("cover_image_url") @db.VarChar(255)
  authors       String[]
  isPrivate     Boolean  @default(false) @map("is_private")
  isFree        Boolean  @default(false) @map("is_free")

  mediaId  BigInt         @map("media_id")
  media    Media          @relation(fields: [mediaId], references: [id])
  chapters MediaChapter[]

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  @@unique([mediaId, number])
  @@map("media_volumes")
}

model MediaChapter {
  id BigInt @id @default(autoincrement())

  number    Int?    @db.SmallInt
  title     String  @db.VarChar(100)
  isPrivate Boolean @default(false) @map("is_private")
  isFree    Boolean @default(false) @map("is_free")

  volumeId   BigInt      @map("volume_id")
  volume     MediaVolume @relation(fields: [volumeId], references: [id])
  mediaPages MediaPage[]

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  @@unique([volumeId, number])
  @@map("media_chapters")
}

model MediaPage {
  id BigInt @id @default(autoincrement())

  number              Int     @db.SmallInt
  imageUrl            String  @map("image_url") @db.VarChar(255)
  hasSensitiveContent Boolean @default(false) @map("has_sensitive_content")
  isPrivate           Boolean @default(false) @map("is_private")
  isFree              Boolean @default(false) @map("is_free")

  chapterId     BigInt        @map("chapter_id")
  chapter       MediaChapter  @relation(fields: [chapterId], references: [id])
  userHistories UserHistory[]

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  @@unique([chapterId, number])
  @@map("media_pages")
}

model MediaGenre {
  id Int @id @default(autoincrement())

  name String @db.VarChar(50)
  slug String @unique @db.VarChar(50)

  medias Media[] @relation(name: "media_to_media_genres")

  @@map("media_genres")
}

enum ReadingProgressStatus {
  IN_PROGRESS @map("in_progress")
  COMPLETED   @map("completed")

  @@map("reading_progress_statuses")
}

model UserReadList {
  id BigInt @id @default(autoincrement())

  subscriberId BigInt     @map("subscriber_id")
  subscriber   Subscriber @relation(fields: [subscriberId], references: [id])

  mediaId BigInt @map("media_id")
  media   Media  @relation(fields: [mediaId], references: [id])

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  @@unique([subscriberId, mediaId])
  @@map("user_read_lists")
}

model UserHistory {
  id BigInt @id @default(autoincrement())

  status     ReadingProgressStatus @default(IN_PROGRESS)
  lastReadAt DateTime              @default(now()) @map("last_read_at") @db.Timestamptz

  subscriberId BigInt     @map("subscriber_id")
  subscriber   Subscriber @relation(fields: [subscriberId], references: [id])
  pageId       BigInt     @map("page_id")
  page         MediaPage  @relation(fields: [pageId], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("user_histories")
}

model Subscription {
  id BigInt @id @default(autoincrement())

  name        String  @db.VarChar(50)
  price       Decimal @db.Decimal(10, 2)
  priceAnnual Decimal @map("price_annual") @db.Decimal(10, 2)
  accessDays  Int     @map("access_days") @db.SmallInt

  subscribers Subscriber[]
  promotions  Promotion[]  @relation("promotion_to_subscription")
  orderItems  OrderItem[]

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  @@map("subscriptions")
}

enum DiscountType {
  PERCENT     @map("percent")
  FIXED_VALUE @map("fixed_value")

  @@map("discount_types")
}

model Promotion {
  id BigInt @id @default(autoincrement())

  code         String       @unique @db.VarChar(50)
  description  String?      @db.VarChar(255)
  discount     Decimal      @db.Decimal(10, 2)
  discountType DiscountType @default(FIXED_VALUE) @map("discount_type")
  startDate    DateTime     @map("start_date") @db.Timestamptz
  endDate      DateTime?    @map("end_date") @db.Timestamptz
  maxUses      Int?         @map("max_uses")
  perUser      Boolean      @default(true) @map("per_user")

  promotionUsages PromotionUsage[]
  subscriptions   Subscription[]   @relation("promotion_to_subscription")
  orders          Order[]
  orderItems      OrderItem[]

  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  @@map("promotions")
}

model PromotionUsage {
  id BigInt @id @default(autoincrement())

  usedAt DateTime @default(now()) @map("used_at") @db.Timestamptz

  subscriberId BigInt     @map("subscriber_id")
  subscriber   Subscriber @relation(fields: [subscriberId], references: [id])
  promotionId  BigInt     @map("promotion_id")
  promotion    Promotion  @relation(fields: [promotionId], references: [id])

  @@unique([subscriberId, promotionId])
  @@map("promotion_usages")
}

enum GatewayStatus {
  PENDING        @map("pending")
  WAITING        @map("waiting")
  GENERATED      @map("generated")
  CANCELED       @map("canceled")
  PAID           @map("paid")
  REFUND         @map("refund")
  PARTIAL_REFUND @map("partial_refund")
  WITH_ERROR     @map("with_error")
  UNDERPAID      @map("underpaid")
  OVERPAID       @map("overpaid")

  @@map("gateway_statuses")
}

enum PaymentMethod {
  BOLETO      @map("boleto")
  CREDIT_CARD @map("credit_card")
  DEBIT_CARD  @map("debit_card")
  PIX         @map("pix")

  @@map("payment_methods")
}

model Order {
  id BigInt @id @default(autoincrement())

  paymentGateway String        @map("payment_gateway") @db.VarChar(50)
  paymentMethod  PaymentMethod @map("payment_method")
  status         GatewayStatus @default(PENDING)
  subtotal       Decimal       @db.Decimal(10, 2)
  total          Decimal       @db.Decimal(10, 2)

  subscriberId BigInt        @map("subscriber_id")
  subscriber   Subscriber    @relation(fields: [subscriberId], references: [id])
  orderItems   OrderItem[]
  orderRefunds OrderRefund[]
  promotionId  BigInt?       @map("promotion_id")
  promotion    Promotion?    @relation(fields: [promotionId], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("orders")
}

model OrderItem {
  id BigInt @id @default(autoincrement())

  subtotal Decimal @db.Decimal(10, 2)
  total    Decimal @db.Decimal(10, 2)

  subscriptionId   BigInt            @map("subscription_id")
  subscription     Subscription      @relation(fields: [subscriptionId], references: [id])
  orderId          BigInt            @map("order_id")
  order            Order             @relation(fields: [orderId], references: [id])
  promotionId      BigInt?           @map("promotion_id")
  promotion        Promotion?        @relation(fields: [promotionId], references: [id])
  orderRefundItems OrderRefundItem[]

  @@map("order_items")
}

model OrderRefund {
  id BigInt @id @default(autoincrement())

  amount Decimal @db.Decimal(10, 2)
  reason String? @db.Text

  orderId          BigInt            @map("order_id")
  order            Order             @relation(fields: [orderId], references: [id])
  orderRefundItems OrderRefundItem[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("order_refunds")
}

model OrderRefundItem {
  id BigInt @id @default(autoincrement())

  amount Decimal @db.Decimal(10, 2)

  orderRefundId BigInt      @map("order_refund_id")
  orderRefund   OrderRefund @relation(fields: [orderRefundId], references: [id])
  orderItemId   BigInt      @map("order_item_id")
  orderItem     OrderItem   @relation(fields: [orderItemId], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([orderRefundId, orderItemId])
  @@map("order_refund_items")
}

model AuditLog {
  id       BigInt  @id @default(autoincrement())
  action   String  @db.VarChar(128)
  metadata Json
  entity   String? @db.VarChar(64)
  entityId String? @map("entity_id") @db.VarChar(32)

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("audit_logs")
}

model Key {
  id        Int       @id @default(autoincrement())
  name      String    @db.VarChar(35)
  hashedKey String    @unique @map("hashed_key") @db.VarChar(255)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  @@map("keys")
}
