{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolvePackageJsonExports": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2023",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "incremental": true,
    "tsBuildInfoFile": "./build/tsconfig.tsbuildinfo",
    "skipLibCheck": true,
    "strict": true,
    "strictPropertyInitialization": false,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "types": [
      "node",
      "vitest/globals",
      "supertest"
    ],
    "paths": {
      "@app/common/*": [
        "./src/common/*"
      ],
      "@app/config/*": [
        "./src/config/*"
      ],
      "@app/db/*": [
        "./src/generated/*"
      ],
      "@app/interfaces/*": [
        "./src/shared/interfaces/*"
      ],
      "@app/modules/*": [
        "./src/modules/*"
      ],
      "@app/shared/*": [
        "./src/shared/*"
      ],
      "@app/validators/*": [
        "./src/common/decorators/validators/*"
      ],
      "@app/types/*": [
        "./src/shared/types/*"
      ],
      "@app/*": [
        "./src/*"
      ]
    }
  }
}
