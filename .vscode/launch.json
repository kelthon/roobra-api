{
  "version": "0.2.0",
  "inputs": [
    {
      "id": "testName",
      "type": "promptString",
      "description": "Test name (or part of it) to debug"
    }
  ],
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Vitest: current file",
      "autoAttachChildProcesses": true,
      "skipFiles": [
        "<node_internals>/**",
        "**/node_modules/**",
        "**/generated/prisma/**"
      ],
      "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
      "args": [
        "run",
        "${relativeFile}",
        "--no-file-parallelism",
        "--test-timeout=0"
      ],
      "smartStep": true,
      "console": "integratedTerminal"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Vitest: one test",
      "autoAttachChildProcesses": true,
      "skipFiles": [
        "<node_internals>/**",
        "**/node_modules/**",
        "**/generated/prisma/**"
      ],
      "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
      "args": [
        "run",
        "${relativeFile}",
        "--no-file-parallelism",
        "--test-timeout=0",
        "-t",
        "${input:testName}"
      ],
      "smartStep": true,
      "console": "integratedTerminal"
    }
  ]
}
